{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Main window: the launcher. Starts and stops the local game through Rust, lists worlds through Rust, and opens the game and multiplayer windows through Rust. No filesystem access of its own.",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "allow-get-push-status",
    "allow-configure-push",
    "allow-send-test-push",
    "allow-get-briefing",
    "allow-open-briefing-page",
    "allow-open-game-page",
    "allow-open-briefing-window",
    "core:default",
    "allow-open-online-window",
    "allow-open-help-destination",
    "allow-open-ask-window",
    "allow-open-game-window",
    "allow-game-start",
    "allow-game-stop",
    "allow-game-status",
    "allow-game-request",
    "allow-list-worlds",
    "allow-create-world",
    "allow-delete-world",
    "allow-touch-world",
    "allow-list-game-versions",
    "allow-install-game-version",
    "allow-select-game-version",
    "process:allow-restart",
    "updater:default",
    "allow-close-embedded-game",
    "allow-set-embedded-visible",
    "allow-refresh-game-view",
    "allow-linked-account",
    "allow-sign-out",
    "allow-link-account",
    "allow-set-statistics-consent",
    "allow-submit-statistics",
    "allow-submit-diagnostics"
  ],
  "webviews": [
    "main"
  ]
}
