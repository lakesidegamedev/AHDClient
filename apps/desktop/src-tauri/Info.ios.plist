<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>AHDWidgetKeychainGroup</key>
  <string>$(AHD_WIDGET_KEYCHAIN_GROUP)</string>
  <key>CFBundleURLTypes</key>
  <array><dict><key>CFBundleURLName</key><string>net.lakesidegames.ahdclient.briefing</string>
    <key>CFBundleURLSchemes</key><array><string>ahdclient</string></array>
  </dict></array>
  <!-- Merged into the generated iOS Info.plist by the Tauri CLI. -->
  <!-- Home screen name. productName stays AHDClient for binaries and release tooling. -->
  <key>CFBundleDisplayName</key>
  <string>A House Divided</string>
  <!-- No app-wide UIUserInterfaceStyle: native sheets (Ask) follow the
       system appearance. The launcher window pins itself dark at runtime
       (NativeLauncherAppearance) and the launch screen is painted the
       launcher color by scripts/configure-ios-widgets.rb. -->
  <!-- Only HTTPS to the game; no proprietary encryption, so no export
       compliance questionnaire on every TestFlight upload. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- Long-press the Home Screen icon. Handled by NativeQuickActions. -->
  <key>UIApplicationShortcutItems</key>
  <array>
    <dict><key>UIApplicationShortcutItemType</key><string>net.lakesidegames.ahdclient.quick.inbox</string>
      <key>UIApplicationShortcutItemTitle</key><string>Inbox</string>
      <key>UIApplicationShortcutItemIconSymbolName</key><string>tray</string></dict>
    <dict><key>UIApplicationShortcutItemType</key><string>net.lakesidegames.ahdclient.quick.actions</string>
      <key>UIApplicationShortcutItemTitle</key><string>Actions</string>
      <key>UIApplicationShortcutItemIconSymbolName</key><string>bolt.fill</string></dict>
    <dict><key>UIApplicationShortcutItemType</key><string>net.lakesidegames.ahdclient.quick.ask</string>
      <key>UIApplicationShortcutItemTitle</key><string>Ask</string>
      <key>UIApplicationShortcutItemIconSymbolName</key><string>sparkles</string></dict>
    <dict><key>UIApplicationShortcutItemType</key><string>net.lakesidegames.ahdclient.quick.briefing</string>
      <key>UIApplicationShortcutItemTitle</key><string>Briefing</string>
      <key>UIApplicationShortcutItemIconSymbolName</key><string>doc.text</string></dict>
  </array>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <!-- iPad: all four orientations, no full-screen opt-out, so Split View and
       Slide Over stay available. Apple rejects multitasking without all four. -->
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
</dict>
</plist>
