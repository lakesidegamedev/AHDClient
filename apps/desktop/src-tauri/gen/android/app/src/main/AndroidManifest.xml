<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.ahdclient_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|fontScale|density|layoutDirection"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/briefing_shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Discord sign-in returns here, not to a browser, when it ran in the
                 Discord app (ticket 1387). Verified against the site's
                 /.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="ahousedividedgame.com" />
                <data android:host="www.ahousedividedgame.com" />
                <data android:host="sandbox.ahousedividedgame.com" />
                <data android:path="/api/auth/discord/callback" />
            </intent-filter>
            <!-- Shared game links open here instead of the browser. Page sections
                 only: never /api, /login, /auth, /register or /logout, so every
                 sign-in stays in the browser. Kept in step with AppLinks.SECTIONS. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="ahousedividedgame.com" />
                <data android:host="www.ahousedividedgame.com" />
                <data android:pathPrefix="/elections" />
                <data android:pathPrefix="/corporation" />
                <data android:pathPrefix="/corporations" />
                <data android:pathPrefix="/state" />
                <data android:pathPrefix="/country" />
                <data android:pathPrefix="/profile" />
                <data android:pathPrefix="/notifications" />
                <data android:pathPrefix="/congress" />
                <data android:pathPrefix="/parties" />
                <data android:pathPrefix="/stockmarket" />
                <data android:pathPrefix="/news" />
                <data android:pathPrefix="/politician" />
                <data android:pathPrefix="/character" />
            </intent-filter>
        </activity>

        <receiver android:name=".OverviewWidget" android:label="@string/widget_name_overview" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/briefing_widget_overview" />
        </receiver>
        <receiver android:name=".ProfileWidget" android:label="@string/widget_name_profile" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/briefing_widget_profile" />
        </receiver>
        <receiver android:name=".ElectionWidget" android:label="@string/widget_name_election" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/briefing_widget_election" />
        </receiver>
        <receiver android:name=".CorporationWidget" android:label="@string/widget_name_corporation" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/briefing_widget_corporation" />
        </receiver>
        <receiver android:name=".StocksWidget" android:label="@string/widget_name_stocks" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/briefing_widget_stocks" />
        </receiver>
        <receiver android:name=".TurnReminderReceiver" android:exported="false" />
        <service android:name=".BriefingRefreshJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
