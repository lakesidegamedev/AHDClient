{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AHDClient",
  "version": "2.7.0",
  "identifier": "net.lakesidegames.ahdclient",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "A House Divided",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#14141c",
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: https://ahousedividedgame.com https://*.ahousedividedgame.com https://cdn.discordapp.com https://*.public.blob.vercel-storage.com",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "A House Divided, on your own machine",
    "longDescription": "AHDClient runs the full A House Divided game locally for singleplayer, and opens the live multiplayer game.",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "externalBin": [
      "binaries/ahd-node"
    ],
    "resources": {
      "resources/game": "game"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFQzYyMzZCMkMwNkM2Q0UKUldUT3hnWXNheVBHbmtmUTRqV0FLcmYxZ3FyayszRHRHVHRFWTFyYzh3NmtRNzZPUFVXb0pMT2kK",
      "endpoints": [
        "https://ops.lakesidegames.net/downloads/AHDClient-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
